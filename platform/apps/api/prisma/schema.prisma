generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum EventStatus {
  SCHEDULED
  POSTPONED
  CANCELED
  FINISHED
}

model Organization {
  id        String   @id @default(uuid()) @db.Uuid
  code      String   @unique @db.VarChar(32)
  name      String   @db.VarChar(120)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  events    Event[]
}

model Event {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  name           String       @db.VarChar(200)
  startTime      DateTime     @db.Timestamptz(3)
  timezone       String       @db.VarChar(64)
  status         EventStatus  @default(SCHEDULED)
  venueName      String?      @db.VarChar(160)
  city           String?      @db.VarChar(100)
  countryCode    String?      @db.Char(2)
  createdAt      DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime     @updatedAt @db.Timestamptz(3)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  fights         Fight[]

  @@index([status, startTime])
  @@index([organizationId, startTime])
}

model Fight {
  id             String   @id @default(uuid()) @db.Uuid
  eventId        String   @db.Uuid
  cardPosition   Int
  redCornerName  String   @db.VarChar(120)
  blueCornerName String   @db.VarChar(120)
  weightClass    String?  @db.VarChar(80)
  isTitleFight   Boolean  @default(false)
  createdAt      DateTime @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @db.Timestamptz(3)
  event          Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([eventId, cardPosition])
}
